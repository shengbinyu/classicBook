                {
                  "pos": 11,
                  "len": 7,
                  "ref": "而罪莫大于不孝",
                  "note": "不孝为万恶之首，此句影响中国社会两千余年。"
                },
                {
                  "pos": 19,
                  "len": 5,
                  "ref": "要君者无上",
                  "note": "要 yāo：要挟、胁迫。无上，目无君上。"
                },
                {
                  "pos": 25,
                  "len": 6,
                  "ref": "非圣人者无法",
                  "note": "非 fěi：同「诽」，诽谤、否定。无法，无视礼法。"
                },
                {
                  "pos": 32,
                  "len": 5,
                  "ref": "非孝者无亲",
                  "note": "无亲：目无父母、否定至亲。"
                },
                {
                  "pos": 38,
                  "len": 6,
                  "ref": "此大乱之道也",
                  "note": "大乱之道：导致社会最大祸乱的根源。"
