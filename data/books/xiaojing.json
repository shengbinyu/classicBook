                  "ref": "守其宗庙",
                  "note": "宗庙：卿大夫之家庙。守宗庙即保家族、承祭祀。"
                },
                {
                  "pos": 81,
                  "len": 7,
                  "ref": "盖卿大夫之孝也",
                  "note": "五孝之三：卿大夫之孝，为朝廷高级官员。"
                },
                {
                  "pos": 95,
                  "len": 4,
                  "ref": "夙夜匪懈",
                  "note": "夙 sù 夜：早晚、从早到晚。匪 fěi：同「非」，不。懈 xiè，懈怠。"
                },
                {
                  "pos": 100,
                  "len": 4,
                  "ref": "以事一人",
                  "note": "一人：指天子。卿大夫佐天子治天下，故一心事之。"
                }
              ]
            }
          ]
